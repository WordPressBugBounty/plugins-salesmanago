{
    "name": "salesmanago/wordpress",
    "description": "Wordpress marketing automation extension",
    "version": "3.13.0",
    "require": {
        "php": ">=7.4",
        "managoai/php-sdk": "4.0.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "fakerphp/faker": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "*",
        "wp-coding-standards/wpcs": "*"
    },
    "autoload": {
        "psr-4": {
            "bhr\\" : "src/",
            "tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
